{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ARESGoldenDataset",
  "type": "object",
  "required": ["version", "domain", "test_cases"],
  "properties": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "domain": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "test_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "query", "reference_contexts", "ground_truth_answer", "tags"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "query": { "type": "string", "minLength": 5 },
          "reference_contexts": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "ground_truth_answer": { "type": "string", "minLength": 5 },
          "expected_entities": {
            "type": "array",
            "items": { "type": "string" }
          },
          "tags": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "difficulty": {
            "enum": ["simple", "multi-hop", "adversarial", "out-of-domain"]
          },
          "expected_behavior": {
            "enum": ["answer", "refuse", "answer_original", "no_pii"]
          },
          "injection_payload": { "type": "string" },
          "parent_id": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
